# Copy this file to .env, fill in the values you need, then run `chmod 600 .env`
# so it is readable only by you. .env is git-ignored; this example file is
# tracked and must never carry a real value -- every assignment below is
# deliberately empty. config.load_dotenv() reads .env once at import time
# and never overwrites a variable that is already set in the environment, so
# a container, CI runner, or exported shell variable always wins over this
# file.

# Comma-separated API keys accepted by POST /api/solve, POST /api/plan and
# GET /api/rate/{entry}. Optional -- leave empty to keep those endpoints open
# (the stub auth described in api/main.py::require_key). Choose your own
# values; there is no external issuer for this key.
FPL_API_KEYS=

# Live bookmaker odds via https://the-odds-api.com (free tier, ~500
# requests/month). Optional -- without it, odds-derived columns are NaN and
# the pipeline continues normally (see data/live_odds.py).
ODDS_API_KEY=

# Comma-separated origins allowed to call the API's CORS-restricted routes.
# Choose the origin(s) your deployed frontend is served from (e.g. the
# Cloudflare Pages URL). Consumed by plan 06-04.
FPL_CORS_ORIGINS=

# Where ops.notify.report POSTs a JSON alert record when a cron step fails.
# A free ntfy.sh topic URL, a Discord channel webhook, or a Slack incoming
# webhook all work. Optional -- without it, alerts are still logged and
# appended to FPL_ALERT_LOG, just not pushed anywhere.
FPL_ALERT_WEBHOOK=

# Path to the JSON Lines alert log ops.notify.report appends to. Optional --
# defaults to data/alerts.jsonl (git-ignored) when unset.
FPL_ALERT_LOG=

# --- E2E fixture-mode seams -------------------------------------------------
# These two point api/main.py and predict/live.py at a frozen, versioned E2E
# fixture capture (see e2e/fixtures/) instead of the live FPL API. They exist
# only so the Playwright suite is calendar-independent. NEVER set either of
# these in a production configuration -- doing so serves stale, frozen data
# to real users.
FPL_FIXTURE_DIR=
FPL_FIXTURE_DATA_DIR=
